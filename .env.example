# Existing app services
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=
GOOGLE_PLACES_API_KEY=
GOOGLE_STREET_VIEW_API_KEY=
# Free Brandfetch Logo API client ID. Without it Buzz falls back to the official website icon.
BRANDFETCH_CLIENT_ID=
CRON_SECRET=

# Transactional account email
RESEND_API_KEY=
SIGNUP_EMAIL_FROM=
OWNER_SIGNUP_WEBHOOK_URL=

# Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@lit757.app

# Event discovery providers
TICKETMASTER_API_KEY=
EVENTBRITE_PRIVATE_TOKEN=
SEATGEEK_CLIENT_ID=
SEATGEEK_CLIENT_SECRET=
# JSON array of HTTPS ICS feeds. Example:
# [{"name":"Scope Arena","url":"https://example.com/calendar.ics","source":"scope_arena","venueName":"Scope Arena"}]
LOCAL_EVENT_FEEDS_JSON=

# Public venue enrichment
# Optional override. Defaults to the public FOSSGIS Overpass endpoint.
OVERPASS_API_URL=
# Optional JSON proxy for HRT GTFS-Realtime vehicle positions.
HRT_GTFS_RT_VEHICLE_POSITIONS_JSON_URL=

# Environment and public-land context
AIRNOW_API_KEY=
NPS_API_KEY=

# AI routing
# OPENAI_API_KEY currently powers /api/recommendation and /api/summary.
OPENAI_API_KEY=
# Reserved for the planned Vercel AI Gateway integration.
AI_GATEWAY_API_KEY=

# Hugging Face ML
# Routes /api/discover through the ML re-ranker. Off unless set to 1 or true, so
# the canonical discovery path never depends on an external ML provider.
# ML re-ranking changes result ORDER only; it never changes a venue's activity score.
ML_DISCOVERY_ENABLED=
# Enables semantic search and automatic vibe detection in Vercel discovery requests.
HUGGINGFACE_API_TOKEN=
# Dedicated bearer secret for protected Vercel ML routes. Use 32+ random characters.
ML_API_SECRET=
# Optional dedicated CPU/GPU worker. Enables cross-encoder reranking, image ranking,
# forecasting, upscaling, segmentation, depth and branded image generation.
ML_WORKER_URL=
# Required by both Vercel and the worker. Use a different 32+ character random value.
ML_WORKER_SECRET=

# Buzz pilot providers
# Private creates forecasts and requests provider-confirmed live data. Public reads existing forecasts.
BESTTIME_API_KEY_PRIVATE=
BESTTIME_API_KEY_PUBLIC=
TICKETMASTER_INVENTORY_API_KEY=
PREDICTHQ_ACCESS_TOKEN=
TOMTOM_API_KEY=

# First-party Buzz evidence and calibration
BUZZ_PARTNER_INGEST_SECRET=
BUZZ_GROUND_TRUTH_SECRET=
